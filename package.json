{
  "name": "apticket",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "lint:security": "eslint --config eslint.security.config.mjs apps packages supabase/functions",
    "test:security-lint": "node scripts/security/test-lint-config.mjs",
    "test:security-http": "node scripts/security/test-server-functions.mjs && node scripts/security/test-portal.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-plugin-security": "4.2.0",
    "typescript-eslint": "8.67.0"
  }
}
