# Copie pra infra/.env e preencha. Usado por `docker compose --env-file .env up`.

NODE_ENV=production
PORT=3001

# Mesmo projeto Supabase do frontend (apps/web) — a URL é a mesma, a key
# aqui é a SERVICE_ROLE (nunca a publishable/anon). Nunca colocar essa
# variável no .env do apps/web.
SUPABASE_URL=http://192.168.3.106:8000
SUPABASE_SERVICE_ROLE_KEY=

# MESMO valor de GOTRUE_JWT_SECRET/PGRST_JWT_SECRET do .env do Supabase
# self-hosted (não é opcional gerar um novo — precisa ser o mesmo, senão a
# API não consegue validar sessão nenhuma). apps/web assina o JWT (login,
# convite, redefinição de senha — autenticação própria, não depende mais do
# GoTrue), apps/api só verifica localmente. Ver README, seção "Autenticação
# própria".
JWT_SECRET=

# Preenchido automaticamente pelo docker-compose.yml (aponta pro serviço
# `redis` na rede interna) — só sobrescreva se for apontar pra um Redis
# fora do compose.
REDIS_URL=redis://redis:6379

# 32 bytes em hex (64 caracteres) — gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Usada pra criptografar (AES-256-GCM) senha IMAP/SMTP e token da uazapi
# antes de gravar no Postgres. Trocar essa chave invalida tudo que já foi
# criptografado com a anterior (não dá pra descriptografar mais).
SECRETS_ENCRYPTION_KEY=

# Documentação interativa em /backend/docs (via proxy do apps/web) ou
# /docs direto na API. Considere desligar em produção pública
# (expõe o contrato completo da API) ou colocar atrás de basic auth no
# reverse proxy.
SWAGGER_ENABLED=true

# Origem do frontend — usado só quando a API é acessada direto (fora do
# proxy same-origin do apps/web), ex.: debug via /docs. Ajuste pro domínio
# real em produção.
CORS_ORIGIN=http://localhost:8080
